# Which data source this build talks to: mock | api
#
# mock — a pure static demo. No backend, nothing to break in front of a client.
#        This is what deploys to Vercel.
# api  — talks to the real service at VITE_API_URL.
#
# Unset or misspelled falls back to mock, deliberately: a demo pointed at an
# unreachable API fails only when it is too late to fix.
VITE_DATA_SOURCE=api
VITE_API_URL=http://localhost:8007/api/v1
VITE_APP_TITLE=Admin Dashboard

# Distribution map, on-premise deployment settings.
#
# VITE_MAP_TILE_URL / VITE_MAP_TILE_ATTRIBUTION: unset here because this
# demo build is a static site on the public internet and the public OSM
# tile server is fine for it. An on-premise deployment with no route to
# the internet must set both to its own tile server.
#
# VITE_ROUTER_URL: left unset deliberately, not just here — see
# src/features/monitoring/lib/snapToRoads.ts. The rounds draw as straight
# legs between stops rather than reaching the public OSRM demo server,
# whose usage policy forbids this kind of traffic anyway. Set this only to
# an OSRM instance this deployment actually controls.